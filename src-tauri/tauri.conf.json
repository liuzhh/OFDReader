{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFD Reader",
  "version": "0.1.0",
  "identifier": "com.ofdreader.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OFD Reader",
        "width": 1120,
        "height": 780,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "liuzhh",
    "homepage": "https://github.com/liuzhh/OFDReader",
    "copyright": "Copyright (c) 2026 liuzhh. MIT licensed.",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "A tiny OFD (GB/T 33190) reader",
    "longDescription": "A lightweight desktop reader for OFD (GB/T 33190) fixed-layout documents. The Rust backend unzips the package and extracts XML parts plus image resources; the webview renders every page to SVG with per-glyph text positioning, and supports zoom and printing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
